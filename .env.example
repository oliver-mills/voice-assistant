# Find keys/voices at elevenlabs.io and console.anthropic.com
ELEVENLABS_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
# ID of the ElevenLabs voice to use for text-to-speech (from the Voice Library)
VOICE_ID=your_voice_id_here
# Optional: eleven_flash_v2_5 is faster, eleven_multilingual_v2 (default) sounds better
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional: for the GitHub MCP server in mcp.json (a read-only token is enough)
# GITHUB_TOKEN=

# Optional: who can reach the server. It only listens on this machine unless
# HOST is set, e.g. 0.0.0.0 for every interface, and then APP_PASSWORD is
# required. Browsers only allow the microphone over HTTPS away from localhost.
# HOST=0.0.0.0
# APP_PASSWORD=choose_something_long
# PORT=3000
# Optional: where history and saved facts are kept (default ./data)
# DATA_DIR=./data
