# Find keys/voices at elevenlabs.io and console.anthropic.com
ELEVENLABS_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
# ID of the ElevenLabs voice to use for text-to-speech (from the Voice Library)
VOICE_ID=your_voice_id_here
# Optional: eleven_flash_v2_5 is faster, eleven_multilingual_v2 (default) sounds better
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
